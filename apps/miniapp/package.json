{
  "name": "@scoreboard/miniapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "taro build --type weapp --watch",
    "build": "taro build --type weapp && npm run check:bundle",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs && node scripts/test-wechat-validation.mjs && node scripts/test-http-runtime.mjs",
    "preview:dom": "node scripts/preview.mjs",
    "dev:cloud": "taro build --type weapp --mode cloud --watch",
    "build:cloud": "taro build --type weapp --mode cloud && npm run check:bundle",
    "check:bundle": "node scripts/check-store-bundle.mjs",
    "dev:http": "taro build --type weapp --mode http --watch",
    "build:http": "taro build --type weapp --mode http && npm run check:bundle",
    "dev:http:ip": "taro build --type weapp --mode http-ip --watch"
  },
  "dependencies": {
    "@scoreboard/shared": "0.1.0",
    "@tarojs/components": "4.3.0",
    "@tarojs/react": "^4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@tarojs/cli": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/vite-runner": "4.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "postcss": "^8.5.31",
    "vite": "^4.5.0"
  }
}
